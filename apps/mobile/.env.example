# Copia este archivo como apps/mobile/.env y reinicia Expo después de cambiarlo.

# URL del API (sin /api/v1).
# - En el navegador (pnpm --filter mobile web): http://localhost:3000
# - En un teléfono con Expo Go: la IP de tu computador en la misma red WiFi,
#   por ejemplo http://192.168.100.9:3000 (la muestra la API al iniciar).
EXPO_PUBLIC_API_URL=http://localhost:3000

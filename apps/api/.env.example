# Copia este archivo como apps/api/.env y ajusta los valores. .env no se sube a GitHub.

# Base de datos (la levanta docker compose; usuario y clave son solo de desarrollo)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/grupo_estudio
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/grupo_estudio_test

# Clave para firmar los JWT. Usa un texto largo y aleatorio; en producción, uno distinto.
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria

# Orígenes permitidos por CORS (Expo web en desarrollo). Separa varios con comas.
CORS_ORIGIN=http://localhost:8081

PORT=3000
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
LOGIN_RATE_LIMIT=5

# Cuenta de administrador que crea "pnpm --filter api db:seed" (solo desarrollo)
SEED_ADMIN_CORREO=admin@duocuc.cl
SEED_ADMIN_PASSWORD=
